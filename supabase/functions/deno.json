{
  "nodeModulesDir": "none",
  "lock": {
    "path": "./deno.lock"
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    },
    "exclude": ["_shared/vendor"]
  },
  "tasks": {
    "check": "deno lint . && deno check --frozen */index.ts",
    "test:jev": "deno test --frozen _shared/jev*.test.ts"
  }
}
