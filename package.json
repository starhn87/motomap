{
  "name": "ridemap",
  "main": "expo-router/entry",
  "version": "1.2.8",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:website": "tsx --test website/tests/*.test.mjs",
    "typecheck:functions": "npx --yes deno@2.9.5 task --config supabase/functions/deno.json check",
    "types:supabase": "npx --yes supabase@2.115.0 gen types --linked --schema public > lib/database.types.ts",
    "check:release": "node scripts/check-release-compatibility.mjs",
    "check:legal": "tsx scripts/check-legal-publication.ts",
    "seed:bike-cafes": "node scripts/seed-bike-cafes.mjs",
    "sync:bikes": "node scripts/sync-bike-models.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mj-studio/react-native-naver-map": "2.9.1",
    "@posthog/react-native-plugin": "2.12.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-kakao/core": "2.4.10",
    "@react-native-kakao/user": "2.4.10",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "57.1.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "4.81.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/node": "~22.20.5",
    "@types/react": "~19.2.0",
    "patch-package": "^8.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.12",
    "typescript": "~6.0.3"
  },
  "private": true
}
