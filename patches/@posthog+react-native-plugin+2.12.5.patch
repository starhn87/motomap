+    "ExponentPushToken\\[[^\\]]+\\]",
+    "(?<![A-Za-z0-9.])-?\\d{1,3}\\.\\d{4,}\\s*,\\s*-?\\d{1,3}\\.\\d{4,}(?![A-Za-z0-9.])",
